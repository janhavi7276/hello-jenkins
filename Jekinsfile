pipeline {

agent any

environment {

REGION = 'ap-south-1'

ACCOUNT = '123456789012'

REPO

= 'hello-jenkins'

INSTANCE = 'none'

REGISTRY =

"${ACCOUNT}.dkr.ecr.${REGION}.amazonaws.com"

IMG = "${REPO}:${BUILD_NUMBER}"

REMOTE

= "${REGISTRY}/${REPO}:latest"

}

def run(cmd) { if (isUnix()) { sh cmd) else { bat cmd } }

def awsRun(cmd) {

withCredentials([

string(credentialsId: 'aws-key-id', variable: 'AWS_ACCESS KEY_ID'), string(credentialsId: 'aws-secret, variable: 'AWS_SECRET_ACCESS_KEY') 1) { run(cmd)}

def ecrLogin() {

) awsRun "aws eor get-login-password-region $(env REGION} | " + "docker login--username AWS-password-stdin $(env.REGISTRY)"

def deploy() {

awsRun "aws ssm send-command region $(env.REGION)"+ "-instance-ids $(env.INSTANCE) + "-document-name AWS-RunShellScript parameters file://deploy.json"

}
